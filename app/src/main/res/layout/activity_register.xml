<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Biru Muda Gelombang (Gelombang Sejajar dengan Gambar KTP) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_dashboard_header_wave"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_back_arrow"
                android:layout_alignParentStart="true"
                android:contentDescription="Kembali" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buka Rekening"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="16dp" />

        </RelativeLayout>

        <!-- Kartu White Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card_white"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-110dp"
            android:layout_marginBottom="32dp">

            <!-- ========================= -->
            <!-- BAGIAN 1: DOKUMEN e-KTP   -->
            <!-- ========================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dokumen"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00529C" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_ktp_illustration"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Ilustrasi KTP" />

            <!-- Button Upload e-KTP Warna Biru Muda dengan Animasi & Pemicu Galeri -->
            <Button
                android:id="@+id/btnUploadKtp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Upload e-KTP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_rect_input"
                android:backgroundTint="#1888E7"
                app:backgroundTint="#1888E7"
                android:paddingHorizontal="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" />

            <!-- ========================= -->
            <!-- BAGIAN 2: DATA DIRI       -->
            <!-- ========================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Utama"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00529C"
                android:layout_marginTop="32dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NIK (16 Digit)"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etNik"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Masukkan NIK"
                android:inputType="number"
                android:maxLength="16"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_rect_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Lengkap"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etRegName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Masukkan nama lengkap"
                android:inputType="textPersonName"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_rect_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nomor Handphone"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_rect_input"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_flag_id"
                    android:contentDescription="Bendera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+62"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#E2E8F0"
                    android:layout_marginHorizontal="12dp" />

                <EditText
                    android:id="@+id/etRegPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="812345678"
                    android:inputType="phone"
                    android:background="@null"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ========================= -->
            <!-- BAGIAN 3: KEAMANAN        -->
            <!-- ========================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keamanan Akun"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00529C"
                android:layout_marginTop="32dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Buat username"
                android:inputType="textVisiblePassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_rect_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_rect_input"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Buat password"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_eye"
                    android:padding="2dp"
                    android:contentDescription="Toggle Password" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PIN BRImo (6 Digit)"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Masukkan 6 angka PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_rect_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <!-- Tombol Buat Rekening Sekarang (Bentuk Kotak @drawable/bg_rect_input) -->
            <Button
                android:id="@+id/btnSubmitRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Buat Rekening Sekarang"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_rect_input"
                android:backgroundTint="#CCCCCC"
                app:backgroundTint="#CCCCCC"
                android:enabled="false"
                android:textAllCaps="false"
                android:layout_marginTop="36dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
