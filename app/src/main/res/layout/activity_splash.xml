<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_shapes"
    tools:context=".SplashActivity">

    <!-- Ornamen Gelombang Pojok Kanan Atas -->
    <ImageView
        android:id="@+id/ivOrnamentTop"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_splash_ornament_top"
        android:contentDescription="Ornamen Atas" />

    <!-- Ornamen Gelombang Pojok Kiri Bawah -->
    <ImageView
        android:id="@+id/ivOrnamentBottom"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:src="@drawable/ic_splash_ornament_bottom"
        android:contentDescription="Ornamen Bawah" />

    <!-- Logo BRImo di Tengah Layar -->
    <ImageView
        android:id="@+id/ivBankLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_brimo_logo"
        android:contentDescription="Logo BRImo" />

    <!-- Teks Footer: Lisensi OJK/LPS & Versi Aplikasi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/tvOjkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PT Bank Rakyat Indonesia Tbk berizin dan diawasi oleh Otoritas Jasa Keuangan (OJK) dan Bank Indonesia, serta merupakan peserta penjaminan LPS."
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Versi 2.100.0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

    </LinearLayout>

</RelativeLayout>