<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".LoginActivity">

    <!-- Top Blue Wave Background Header -->
    <ImageView
        android:id="@+id/ivHeaderWaveBg"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:src="@drawable/bg_login_wave"
        android:scaleType="fitXY"
        android:contentDescription="Header Background" />

    <!-- Ornamen Garis-Garis Kanan Atas -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_splash_ornament_top"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:alpha="0.7"
        android:contentDescription="Ornamen Garis Kanan Atas" />

    <!-- Ornamen Garis-Garis Kiri Bawah Header -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_splash_ornament_bottom"
        android:layout_alignBottom="@id/ivHeaderWaveBg"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="80dp"
        android:alpha="0.7"
        android:contentDescription="Ornamen Garis Kiri Bawah" />

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp">

        <!-- ID / Language Switcher -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_input"
            android:backgroundTint="#20FFFFFF"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flag_id"
                android:contentDescription="ID" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- BRImo Logo Top Center -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_brimo_logo"
            android:layout_centerHorizontal="true"
            android:contentDescription="BRImo" />

        <!-- Kontak Kami -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_input"
            android:backgroundTint="#20FFFFFF"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_alignParentEnd="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_call"
                android:contentDescription="Kontak" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kontak Kami"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Banner Text (Tetap Di Atas Dekat Top Bar) -->

    <!-- Center Section: Register Image (Diturunkan Lebih Ke Bawah Dekat Fast Menu) -->

    <TextView
        android:id="@+id/tvEventBannerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutTopBar"
        android:layout_marginTop="74dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Selamat Memperingati Hari Statistik\nNasional 2026"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_above="@id/layoutBottomSection"
        android:layout_below="@id/tvEventBannerTitle"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp">

        <!-- Center Image: register_brimo_1 (Ditempel langsung tanpa container) -->
        <ImageView
            android:id="@+id/ivRegisterImageCenter"
            android:layout_width="320dp"
            android:layout_height="250dp"
            android:src="@drawable/register_brimo_1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Ilustrasi BRImo" />

    </LinearLayout>

    <!-- Bottom Section: Fast Menu & Login Button -->
    <LinearLayout
        android:id="@+id/layoutBottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:paddingTop="0dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="16dp"
        android:elevation="0dp">

        <!-- Fast Menu Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Menu"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00529C" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                app:tint="#00529C"
                android:layout_marginStart="6dp"
                android:contentDescription="Info Fast Menu" />
        </LinearLayout>

        <!-- Fast Menu Horizontal Scroll (7 Items) -->
        <HorizontalScrollView
            android:id="@+id/hsvFastMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <!-- 1. QRIS -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_qris"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="QRIS" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QRIS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 2. BRIVA -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_briva"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="BRIVA" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BRIVA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 3. E Wallet -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_topup"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="Wallet" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E Wallet"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 4. Transfer -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_transfer"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="Transfer" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transfer"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 5. Pulsa -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_pulsa"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="Pulsa" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pulsa"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 6. Belanja -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_shopping_cart"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="Belanja" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Belanja"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 7. Lainnya -->
                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_bri_products"
                        android:background="@drawable/bg_feature_icon_box"
                        android:padding="10dp"
                        android:contentDescription="Lainnya" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lainnya"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Continuous Scroll Track Bar Indicator (Sesuai Foto) -->
        <FrameLayout
            android:id="@+id/layoutScrollTrack"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="#E5E7EB"
            app:backgroundTint="#E5E7EB"
            android:layout_marginBottom="28dp">

            <!-- Active Blue Indicator Thumb (Bergeser Seiring Scroll) -->
            <View
                android:id="@+id/indicatorThumb"
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_pill_button"
                android:backgroundTint="#00529C"
                app:backgroundTint="#00529C" />
        </FrameLayout>

        <!-- Login & Fingerprint Row (Warna Biru Tua) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Login Button (Murni Biru Tua) -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Login"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_rect_input"
                android:backgroundTint="#00529C"
                app:backgroundTint="#00529C"
                android:layout_marginEnd="8dp" />

            <!-- Fingerprint Button (Murni Biru Tua) -->
            <ImageButton
                android:id="@+id/btnFingerprint"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rect_input"
                android:backgroundTint="#00529C"
                app:backgroundTint="#00529C"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/white"
                android:contentDescription="Fingerprint"
                android:padding="10dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
