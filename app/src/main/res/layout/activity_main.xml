<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/bank_bg"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/ivIkon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_bank_logo"
        android:contentDescription="Icon" />

    <TextView
        android:id="@+id/tvInstruksi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bankku M-Banking"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/bank_primary"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan nama di sini"
        android:inputType="textPersonName"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnSapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lanjut"
        android:backgroundTint="@color/bank_primary"
        android:textColor="@color/white"
        android:layout_marginTop="24dp" />

</LinearLayout>