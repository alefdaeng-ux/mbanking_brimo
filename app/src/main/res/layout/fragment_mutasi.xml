        android:layout_height="wrap_content"
        android:background="#1888E7"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mutasi"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <!-- Tabs: Mutasi Transaksi & e-Statement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_input"
            android:backgroundTint="#0E6EC7"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- Tab 1: Mutasi Transaksi -->
            <TextView
                android:id="@+id/tabMutasi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:backgroundTint="@color/white"
                android:text="Mutasi Transaksi"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1888E7"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tab 2: e-Statement -->
            <TextView
                android:id="@+id/tabStatement"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="e-Statement"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

