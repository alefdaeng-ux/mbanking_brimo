<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_card_white"
    android:padding="24dp">

    <!-- Dialog Header Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Top Up Saldo BRImo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#00529C"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Masukkan nominal atau pilih jumlah di bawah ini"
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- Input Box Custom Nominal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nominal Top Up (Rp)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_rect_input"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#00529C" />

        <EditText
            android:id="@+id/etTopUpAmount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="1.000.000"
            android:inputType="number"
            android:background="@null"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:textColorHint="#9CA3AF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Quick Nominal Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilihan Nominal Cepat"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnChip100k"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:text="100.000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00529C"
            android:background="@drawable/bg_light_blue_card"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnChip500k"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:text="500.000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00529C"
            android:background="@drawable/bg_light_blue_card"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnChip1m"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:text="1.000.000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00529C"
            android:background="@drawable/bg_light_blue_card"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnChip2m"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_columnWeight="1"
            android:text="2.000.000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00529C"
            android:background="@drawable/bg_light_blue_card"
            android:layout_margin="4dp" />

    </GridLayout>

    <!-- Confirm Button -->
    <Button
        android:id="@+id/btnConfirmTopUp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Top Up Sekarang"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_rect_input"
        android:backgroundTint="#1888E7"
        app:backgroundTint="#1888E7" />

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/btnCancelTopUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Batal"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
